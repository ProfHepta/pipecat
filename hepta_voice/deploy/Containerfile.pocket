FROM docker.io/library/ubuntu:24.04
LABEL org.opencontainers.image.title="Hepta Pocket4 voice runtime"
LABEL org.opencontainers.image.description="Python 3.12 only; no inference weights, network or phone devices embedded"
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv ca-certificates \
      libstdc++6 libgomp1 libgcc-s1 libatomic1 libsndfile1 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
CMD ["/usr/bin/python3", "--version"]
